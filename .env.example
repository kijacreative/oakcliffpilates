# Trainer HQ — server-side only. Set these in Vercel → Project → Settings →
# Environment Variables. None of them are ever sent to a browser.

# --- Session signing -------------------------------------------------------
# Any long random string. Rotating it signs everyone out.
#   openssl rand -hex 32
HQ_SESSION_SECRET=

# --- Sign in with Slack (OpenID Connect) -----------------------------------
# api.slack.com/apps → your app → Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Only this workspace may sign in. Slack → About this workspace → Workspace ID.
SLACK_TEAM_ID=

# --- Slack bot (announcements feed + posting studio issues) ----------------
# OAuth & Permissions → Bot User OAuth Token. Scopes:
#   channels:history, channels:read, users:read, chat:write
# Invite the bot to both channels: /invite @OCP Trainer HQ
SLACK_BOT_TOKEN=
SLACK_ANNOUNCEMENTS_CHANNEL=general
SLACK_ISSUES_CHANNEL=studio-issues

# --- Events feed (Apps Script web app bound to the events workbook) --------
# See tools/apps-script/ocp-events-feed.gs for the script and how to deploy it.
EVENTS_FEED_URL=
EVENTS_FEED_TOKEN=

# --- New-client leads (popup + footer signup) ------------------------------
# Zapier catch hook wired to Arketa's "Add New Client" action:
#   Zapier → Create Zap → Trigger "Webhooks by Zapier · Catch Hook"
#                       → Action  "Arketa · Add New Client"
# Copy the hook URL here. Map firstName, lastName, email, phone,
# emailOptIn, smsOptIn and reason onto the Arketa fields; "reason" is worth
# sending as a tag or lead source so you can see what brought people in.
#
# Arketa's own API key (Settings → Integrations → Zapier) goes into the
# Zapier connection, not here — this site never holds it.
#
# Until this is set, /api/lead returns 503 and the popup falls back to
# Arketa's hosted intake form. It never reports a lead it did not deliver.
LEAD_WEBHOOK_URL=
